{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../out/tauri/plotpilot-backend/": "plotpilot-backend/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
